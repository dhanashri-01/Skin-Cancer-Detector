body {
  margin: 0;
  padding: 0;
  font-family: "Nunito", sans-serif;
  background: linear-gradient(135deg, #020617, #0f172a, #1e3a8a);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  color: white;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px);}
  to { opacity: 1; transform: translateY(0);}
}

@keyframes pulse {
  0% { transform: scale(1);}
  50% { transform: scale(1.05);}
  100% { transform: scale(1);}
}

@keyframes slideIn {
  from { opacity: 0; transform: translateX(-20px);}
  to { opacity: 1; transform: translateX(0);}
}

/* Main Container */
.mobilenet-demo-container {
  width: 940px;
  margin: 40px auto;
  padding: 25px;
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(14px);
  border-radius: 22px;
  border: 1px solid rgba(56, 189, 248, 0.2);
  box-shadow: 0 15px 40px rgba(0, 191, 255, 0.15);
  animation: fadeIn 1s ease;
}

/* Title */
.mobilenet-demo-container h1 {
  text-align: center;
  font-size: 36px;
  font-weight: 700;
  color: #38bdf8;
  margin-bottom: 30px;
  text-shadow: 0 0 18px rgba(56, 189, 248, 0.4);
}

/* Wrapper */
.demo-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

/* Buttons */
.input-button {
  background: linear-gradient(135deg, #2563eb, #06b6d4);
  color: white;
  border: none;
  border-radius: 12px;
  padding: 12px 22px;
  margin: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 16px rgba(6, 182, 212, 0.35);
}

.input-button:hover {
  transform: translateY(-3px);
  background: linear-gradient(135deg, #1d4ed8, #0891b2);
}

.predict-button {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  animation: pulse 2s infinite;
}

.predict-button:hover {
  background: linear-gradient(135deg, #dc2626, #991b1b);
}

/* Output Section */
.demo-output {
  display: flex;
  gap: 20px;
  margin-top: 30px;
  flex-wrap: wrap;
}

.out-box {
  flex: 1;
  min-width: 400px;
  min-height: 420px;
  background: rgba(30, 41, 59, 0.9);
  border-radius: 18px;
  padding: 20px;
  border: 1px solid rgba(56, 189, 248, 0.15);
  box-shadow: 0 10px 28px rgba(0,0,0,0.25);
  animation: fadeIn 0.8s ease;
}

/* Image */
#test-image {
  width: 100%;
  height: 350px;
  object-fit: cover;
  border-radius: 16px;
  border: 2px solid rgba(56, 189, 248, 0.25);
}

/* Prediction */
#prediction {
  font-size: 20px;
  font-weight: 600;
  color: #f8fafc;
  background: rgba(56, 189, 248, 0.08);
  padding: 16px;
  border-left: 5px solid #38bdf8;
  border-radius: 10px;
  text-align: center;
  animation: slideIn 0.5s ease;
}

.predictions-title {
  text-align: center;
  color: #38bdf8;
  font-size: 18px;
  margin-top: 20px;
}

/* Prediction List */
#predict-list {
  list-style: none;
  padding: 0;
}

#predict-list li {
  background: rgba(15, 23, 42, 0.85);
  padding: 14px 18px;
  margin-bottom: 12px;
  border-radius: 12px;
  display: flex;
  justify-content: space-between;
  border: 1px solid rgba(56, 189, 248, 0.1);
  transition: 0.3s ease;
}

#predict-list li:hover {
  transform: translateX(6px);
  border-color: #38bdf8;
}

#predict-list li:nth-child(1) {
  color: #22c55e;
}

#predict-list li:nth-child(2) {
  color: #facc15;
}

#predict-list li:nth-child(3) {
  color: #ef4444;
}

/* Chart */
.chart-container {
  margin-top: 35px;
}

.chart-box {
  background: rgba(15, 23, 42, 0.9);
  border-radius: 18px;
  padding: 20px;
  border: 1px solid rgba(56, 189, 248, 0.15);
}

#predChart {
  width: 100% !important;
  height: 320px !important;
}

/* Loading */
#progress-box {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #0f172a;
  border: 2px solid #38bdf8;
  border-radius: 14px;
  padding: 18px 28px;
  box-shadow: 0 0 25px rgba(56, 189, 248, 0.35);
  z-index: 1000;
}

.progress-content {
  display: flex;
  align-items: center;
  gap: 15px;
}

#demo-load {
  width: 28px;
  height: 28px;
}

/* Overlay */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px);
  z-index: 999;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #1e293b;
}

::-webkit-scrollbar-thumb {
  background: #38bdf8;
  border-radius: 8px;
}

/* Responsive */
@media (max-width: 992px) {
  .mobilenet-demo-container {
    width: 95%;
  }

  .demo-output {
    flex-direction: column;
  }

  .out-box {
    min-width: 100%;
  }

  #test-image {
    height: 280px;
  }
}